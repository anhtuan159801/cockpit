# Cockpit on Koyeb — environment variables
# Copy to .env and fill in values. Do NOT commit .env.

# --- Supabase (optional — enables config snapshot sync) ---
# Project URL (Settings → API). Must be HTTPS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Service-role key (server-side only). Legacy name also accepted.
SUPABASE_SECRET_KEY=eyJhbGciOi...your_service_role_key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 32-byte key for AES-256-GCM envelope encryption, base64-encoded.
# Generate: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SUPABASE_SYNC_ENCRYPTION_KEY=BASE64_32_BYTE_KEY_HERE

# Instance identifier (regex: ^[A-Za-z0-9._-]{1,128}$). Stable per deployment.
SUPABASE_SYNC_INSTANCE_ID=cockpit-prod-1

# --- Koyeb (usually injected automatically) ---
# PORT is set by Koyeb. Do not hardcode unless running outside Koyeb.
# PORT=9090

# --- Bridge overlay (build-time, optional) ---
# Set to 1 only when the fork diverges from upstream and needs a patched bridge.
# BUILD_BRIDGE=0
